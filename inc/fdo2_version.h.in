/**
 * @file fdo2_version.h
 * @brief FDO2 driver version, generated by CMake from fdo2_version.h.in.
 * @copyright Copyright (c) 2026 The driver-fdo2 authors. SPDX-License-Identifier: MIT
 *
 * Do not edit the generated file: the version is set once, in cmake/fdo2_build_settings.cmake, and
 * configure_file() writes it here.
 */
#ifndef FDO2_VERSION_H
#define FDO2_VERSION_H

/** Major version: incompatible API changes. */
#define FDO2_VERSION_MAJOR @FDO2_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define FDO2_VERSION_MINOR @FDO2_VERSION_MINOR@
/** Patch version: fixes. */
#define FDO2_VERSION_PATCH @FDO2_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define FDO2_VERSION_STRING "@FDO2_VERSION@"

#endif // FDO2_VERSION_H
